# Copy this file to .env.local and fill in your values. Do NOT commit secrets.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key

# Supabase Direct Connection string (use the "Connection string (direct)" from Supabase)
# Example: postgresql://postgres:password@host:5432/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:password@host:5432/postgres"

# Optional: service role (server only)
SUPABASE_SERVICE_ROLE_KEY=service-role-key

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
# PostHog browser analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host
# Server-only values for querying historical visitor totals
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=

# Video clipper (server-only). Configure this directly in Vercel; do not commit real credentials.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
VIDEO_CLIPPER_MODEL=openai/gpt-5.6-luna

# AI visibility needs an OpenRouter key; set to true only for local demo data.
OPENROUTER_API_KEY=
AI_VISIBILITY_MOCK=false
